{
  "name": "personal-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.js --host 127.0.0.1",
    "data": "node scripts/build-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test --config tests/playwright.config.js",
    "build": "vite build --config app/vite.config.js",
    "preview": "vite preview --config app/vite.config.js --host 127.0.0.1",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.1.1",
    "svelte": "^5.38.0",
    "vite": "^7.1.1"
  }
}
